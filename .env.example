# Change every value before deployment. Never commit your real .env file.
# Supabase Dashboard → Connect → copy Direct connection (or Session pooler for IPv4-only hosts).
# Replace YOUR_ENCODED_PASSWORD and YOUR_PROJECT_REF. URL-encode special characters in the password.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_ENCODED_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# Use small connection limits to respect your Supabase plan's connection pool.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production
# Optional: use this instead of ADMIN_PASSWORD after precomputing a bcrypt hash.
# ADMIN_PASSWORD_HASH=$2b$...
SECRET_KEY=replace-with-a-long-random-secret
BASE_URL=http://localhost:8000
# Optional deployment settings
# PORT=8000
# COOKIE_SECURE=true
# Local-only fallback if you do not use Supabase:
# DATABASE_URL=sqlite:///database/techquiz.db
